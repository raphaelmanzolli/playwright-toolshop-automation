{
  "name": "playwright-quality-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "Projeto de portfólio de automação E2E com Playwright, TypeScript e CI.",
  "scripts": {
    "bddgen": "bddgen",
    "test": "pnpm bddgen && playwright test",
    "test:smoke": "pnpm bddgen && playwright test --grep @smoke",
    "test:regression": "pnpm bddgen && playwright test --grep @regression",
    "test:front": "pnpm bddgen && playwright test --grep @front",
    "test:api": "pnpm bddgen && playwright test --project=api",
    "test:integration": "pnpm bddgen && playwright test --grep @integration",
    "test:headed": "pnpm bddgen && playwright test --headed",
    "test:ui": "pnpm bddgen && playwright test --ui",
    "test:debug": "pnpm bddgen && playwright test --debug",
    "test:chromium": "pnpm bddgen && playwright test --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "playwright-bdd": "9.2.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
